# IBKR Configuration
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_PAPER_TRADING=True
IBKR_MARKET_DATA_TYPE=1 # 1=real-time, 2=frozen, 3=delayed, 4=delayed-frozen
IBKR_TRY_REALTIME_FALLBACK=False # Try real-time after delayed only if True
# Restart after repeated IBKR connection retries
IBKR_MAX_CONNECT_RETRIES=5
IBKR_RESTART_DELAY_SEC=1.0

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Risk Management
LOSS_THRESHOLD_1=0.05  # 5% loss threshold for notification
LOSS_THRESHOLD_2=0.10  # 10% loss threshold for auto close
CHECK_INTERVAL=5  # Check interval in minutes

# DOM Cache Retention (in days)
DOM_CACHE_RETENTION_DAYS=1

# Web UI
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
VISITOR_USERNAME=guest
VISITOR_PASSWORD=guest_password
JWT_SECRET=please_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=1
