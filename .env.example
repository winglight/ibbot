# =============================================================================
# ibbot environment template
# =============================================================================
# Copy this file to `.env` for shared defaults or `.env.local` for machine-specific
# overrides. The application will automatically load `.env.local` first, then `.env`,
# and finally fall back to this template when no custom file is present.
#
# ⚠️ Security: update authentication secrets before exposing the service.
# ⚙️ Runtime directories: application data is stored under `data/` and logs
#    are persisted to `data/logs/`.

# -----------------------------------------------------------------------------
# Core service configuration
# -----------------------------------------------------------------------------
WEB_HOST=0.0.0.0
WEB_PORT=8000
COMPOSE_PROFILES=ib-services,market,risk,strategy,notifications,monitoring,optimizer
ENABLED_MODULES=ALL
AUTO_CONNECT=false
IBBOT_DISABLE_TRADING=false
IBBOT_API_URL=
CORS_ALLOW_ORIGINS=
CURRENT_PRICE_CACHE_ONLY=false
STRATEGY_CACHE_MAX_RECENT=200
STRATEGY_METADATA_REDIS_PREFIX=json:strategy:default

# -----------------------------------------------------------------------------
# Authentication / security
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
VISITOR_USERNAME=
VISITOR_PASSWORD=
JWT_SECRET=please_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# IBKR connectivity & resiliency
# -----------------------------------------------------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_PAPER_TRADING=true
IBKR_MARKET_DATA_TYPE=3
IBKR_TRY_REALTIME_FALLBACK=false
IBKR_MAX_CONNECT_RETRIES=5
IBKR_RESTART_DELAY_SEC=1.0
IBKR_ENABLE_PROCESS_RESTART=false
IBKR_GATEWAY_SERVICE_NAME=ib-gateway
IBKR_GATEWAY_RESTART_CMD=
IBKR_DATA_FARM_WAKEUP_SYMBOL=SPY

# -----------------------------------------------------------------------------
# Risk management defaults
# -----------------------------------------------------------------------------
STOP_LOSS_RATIO=0.05
TAKE_PROFIT_RATIO=0.05
PRICE_THRESHOLD=0.02
ENABLE_TRAILING_SL_TP=true
LEVERAGE_INDEX_DEFAULT=20
LEVERAGE_INDEX_MICRO_DEFAULT=20
LEVERAGE_ES=20
LEVERAGE_MES=20
LEVERAGE_NQ=20
LEVERAGE_MNQ=20
LEVERAGE_YM=20
LEVERAGE_MYM=20
LEVERAGE_RTY=20
LEVERAGE_M2K=20
LEVERAGE_VX=10
CB_DAILY_R=3.0
CB_STREAK=3
RISK_PER_TRADE_R=0.005
RV_REF_VALUE=1.0
RV_REF_METHOD=static
VOL_WINDOW=20
DD_STEP=0.05
DD_MAX_STEPS=4
DD_SCALE=0.5
CONTRACT_ROUNDING=floor

# -----------------------------------------------------------------------------
# Account snapshots & caching
# -----------------------------------------------------------------------------
# Canonical Redis endpoint shared by services, queues, and caches.
IBBOT_REDIS_URL=redis://127.0.0.1:6379/0

# Optional overrides. Leave blank to inherit ``IBBOT_REDIS_URL``.
ACCOUNT_CACHE_REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=
IB_COMMAND_REDIS_URL=
IB_FEED_REDIS_URL=
STRATEGY_REDIS_URL=redis://127.0.0.1:6379/0
NOTIFICATION_REDIS_URL=
DATA_LAYER_REDIS_URL=redis://127.0.0.1:6379/0
ORDERS_REDIS_URL=redis://127.0.0.1:6379/0
ACCOUNT_ORDERS_SNAPSHOT_KEY=json:orders:snapshot:default

# Host-level fields only apply when no URL variables are provided.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
# Timeout guards (seconds). Reduce hangs when Redis is unreachable.
REDIS_CONNECT_TIMEOUT=1.0
# Leave blank (recommended) so Redis streams can block without disconnecting
REDIS_SOCKET_TIMEOUT=
REDIS_PING_TIMEOUT=3.0

ACCOUNT_SNAPSHOT_REFRESH_INTERVAL_SECONDS=15
ACCOUNT_SNAPSHOT_CHECK_INTERVAL_SECONDS=15

# -----------------------------------------------------------------------------
# Unified market data layer (MariaDB/Redis)
# -----------------------------------------------------------------------------
DATA_LAYER_MODE=
IBBOT_DB_NAME=ibbot
IBBOT_DB_USER=ibbot
IBBOT_DB_PASSWORD=change_me
IBBOT_DB_ROOT_PASSWORD=change_root_password
IBBOT_DB_HOST=127.0.0.1
IBBOT_DB_PORT=3306
IBBOT_DB_URL=mysql+pymysql://ibbot:change_me@127.0.0.1:3306/ibbot?charset=utf8mb4

# -----------------------------------------------------------------------------
# Optimiser / background services
# -----------------------------------------------------------------------------
OPTIMIZER_HOST=0.0.0.0
OPTIMIZER_DB_PATH=data/optimizer.db

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
# Notification micro-service endpoint.
# - Docker Compose services default to http://notification:8055
# - Override to http://127.0.0.1:8055 (or another host) when running processes manually.
# Default container port is 8055; adjust when exposing the service directly.
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8055
NOTIFICATION_SERVICE_TIMEOUT=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# DOM automation & tuning
# -----------------------------------------------------------------------------
DOM_SIGNAL_OUTCOME_DELAY_SECONDS=300
DOM_SIGNAL_OUTCOME_THRESHOLD=0.005
DOM_CACHE_RETENTION_DAYS=7
DOM_AUTOMATION_DEFAULT_INTERVAL_MINUTES=60
DOM_AUTOMATION_DEFAULT_LOOKBACK_MINUTES=240
DOM_AUTOMATION_DEFAULT_MIN_SIGNALS=20
DOM_AUTOMATION_DEFAULT_APPLY_UPDATES=true
DOM_AUTOMATION_DEFAULT_SYMBOL=MNQ
DOM_AUTOMATION_DEFAULT_LIMIT=500

# -----------------------------------------------------------------------------
# Miscellaneous diagnostics
# -----------------------------------------------------------------------------
LOG_FILE_PATH=data/logs/ibbot.log
PYTEST_CURRENT_TEST=
