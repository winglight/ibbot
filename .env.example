# IBKR Configuration
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_PAPER_TRADING=True
IBKR_MARKET_DATA_TYPE=1 # 1=real-time, 2=frozen, 3=delayed, 4=delayed-frozen
IBKR_TRY_REALTIME_FALLBACK=False # Try real-time after delayed only if True
# Restart after repeated IBKR connection retries
IBKR_MAX_CONNECT_RETRIES=5
IBKR_RESTART_DELAY_SEC=1.0

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Risk Management
LOSS_THRESHOLD_1=0.05  # 5% loss threshold for notification
LOSS_THRESHOLD_2=0.10  # 10% loss threshold for auto close
CHECK_INTERVAL=5  # Check interval in minutes

# DOM & Signal Evaluation (optional)
DOM_SIGNAL_OUTCOME_DELAY_SECONDS=300
DOM_SIGNAL_OUTCOME_THRESHOLD=0.005
DOM_CACHE_RETENTION_DAYS=7
DOM_AUTOMATION_DEFAULT_INTERVAL_MINUTES=60
DOM_AUTOMATION_DEFAULT_LOOKBACK_MINUTES=240
DOM_AUTOMATION_DEFAULT_MIN_SIGNALS=20
DOM_AUTOMATION_DEFAULT_APPLY_UPDATES=true
DOM_AUTOMATION_DEFAULT_SYMBOL=MNQ
DOM_AUTOMATION_DEFAULT_LIMIT=500

# Web UI
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
VISITOR_USERNAME=guest
VISITOR_PASSWORD=guest_password
JWT_SECRET=please_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=1

# Unified Market Data Layer
# DATA_LAYER_MODE can be 'legacy', 'unified', or 'dual'. Leaving it unset keeps legacy behaviour.
# DATA_LAYER_REDIS_URL enables Redis caching (e.g. redis://:password@redis:6379/0). Leave empty to use in-memory cache.
# DATA_LAYER_REDIS_PREFIX customises key namespace; DATA_LAYER_REDIS_SNAPSHOT_TTL sets snapshot TTL (seconds).
# DATA_LAYER_INFLUX_* configure InfluxDB persistence; leave unset to disable writes.
DATA_LAYER_MODE=
DATA_LAYER_REDIS_URL=
DATA_LAYER_REDIS_PREFIX=market-data
DATA_LAYER_REDIS_SNAPSHOT_TTL=
DATA_LAYER_INFLUX_URL=
DATA_LAYER_INFLUX_BUCKET=
DATA_LAYER_INFLUX_ORG=
DATA_LAYER_INFLUX_TOKEN=
DATA_LAYER_INFLUX_MEASUREMENT=market_events

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_USE_TLS=False