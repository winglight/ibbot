{
  "openapi": "3.0.0",
  "info": {
    "title": "IBKR Trading Bot API",
    "description": "Interactive Brokers Trading Bot API Documentation - 自动化交易机器人接口文档",
    "version": "1.0.0",
    "contact": {
      "name": "IBKR Trading Bot",
      "url": "https://github.com/your-repo/ibkr-trading-bot"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "本地开发服务器"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {"type": "string", "description": "用户名"},
          "password": {"type": "string", "description": "密码"}
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "access_token": {"type": "string", "description": "JWT访问令牌"},
          "token_type": {"type": "string", "example": "bearer"}
        }
      },
      "ConnectionStatus": {
        "type": "object",
        "properties": {
          "connected": {"type": "boolean", "description": "连接状态"},
          "account_id": {"type": "string", "description": "账户ID"},
          "connection_time": {"type": "string", "description": "连接时间"}
        }
      },
      "OrderRequest": {
        "type": "object",
        "required": ["symbol", "action", "quantity", "order_type"],
        "properties": {
          "symbol": {"type": "string", "description": "股票代码", "example": "AAPL"},
          "action": {"type": "string", "enum": ["BUY", "SELL"], "description": "买卖方向"},
          "quantity": {"type": "integer", "description": "数量", "example": 100},
          "order_type": {"type": "string", "enum": ["MKT", "LMT"], "description": "订单类型"},
          "price": {"type": "number", "description": "限价单价格（限价单必填）"},
          "stop_loss": {"type": "number", "description": "止损价格"},
          "take_profit": {"type": "number", "description": "止盈价格"}
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "order_id": {"type": "string", "description": "订单ID"},
          "symbol": {"type": "string", "description": "股票代码"},
          "action": {"type": "string", "description": "买卖方向"},
          "quantity": {"type": "integer", "description": "数量"},
          "order_type": {"type": "string", "description": "订单类型"},
          "price": {"type": "number", "description": "价格"},
          "status": {"type": "string", "description": "订单状态"},
          "filled_quantity": {"type": "integer", "description": "已成交数量"},
          "avg_fill_price": {"type": "number", "description": "平均成交价格"},
          "timestamp": {"type": "string", "description": "时间戳"},
          "order_source": {"type": "string", "description": "订单来源"}
        }
      },
      "AccountInfo": {
        "type": "object",
        "properties": {
          "account_id": {"type": "string", "description": "账户ID"},
          "net_liquidation": {"type": "number", "description": "净清算价值"},
          "total_cash_value": {"type": "number", "description": "现金总值"},
          "buying_power": {"type": "number", "description": "购买力"},
          "unrealized_pnl": {"type": "number", "description": "未实现盈亏"},
          "realized_pnl": {"type": "number", "description": "已实现盈亏"}
        }
      },
      "Position": {
        "type": "object",
        "properties": {
          "symbol": {"type": "string", "description": "股票代码"},
          "position": {"type": "number", "description": "持仓数量"},
          "avg_cost": {"type": "number", "description": "平均成本"},
          "market_price": {"type": "number", "description": "市场价格"},
          "market_value": {"type": "number", "description": "市值"},
          "unrealized_pnl": {"type": "number", "description": "未实现盈亏"},
          "realized_pnl": {"type": "number", "description": "已实现盈亏"}
        }
      },
      "RiskRule": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "description": "规则ID"},
          "symbol": {"type": "string", "description": "股票代码"},
          "rule_type": {"type": "string", "enum": ["stop_loss", "take_profit"], "description": "规则类型"},
          "trigger_price": {"type": "number", "description": "触发价格"},
          "percentage": {"type": "number", "description": "百分比阈值"},
          "is_active": {"type": "boolean", "description": "是否激活"},
          "created_at": {"type": "string", "description": "创建时间"}
        }
      },
      "Strategy": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "策略名称"},
          "description": {"type": "string", "description": "策略描述"},
          "is_active": {"type": "boolean", "description": "是否激活"},
          "webhook_url": {"type": "string", "description": "Webhook URL"},
          "auth_token": {"type": "string", "description": "认证令牌"},
          "created_at": {"type": "string", "description": "创建时间"}
        }
      },
      "HistoricalDataRequest": {
        "type": "object",
        "required": ["symbol", "period", "bar_size"],
        "properties": {
          "symbol": {"type": "string", "description": "股票代码", "example": "AAPL"},
          "period": {"type": "string", "description": "时间周期", "example": "1 D"},
          "bar_size": {"type": "string", "description": "K线大小", "example": "1 min"}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": {"type": "string", "description": "错误详情"}
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/login": {
      "post": {
        "tags": ["认证"],
        "summary": "用户登录",
        "description": "使用用户名和密码登录系统，获取JWT令牌",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/connect": {
      "post": {
        "tags": ["连接管理"],
        "summary": "连接IBKR",
        "description": "建立与Interactive Brokers的连接",
        "responses": {
          "200": {
            "description": "连接成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string", "example": "连接成功"}
                  }
                }
              }
            }
          },
          "500": {
            "description": "连接失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/disconnect": {
      "post": {
        "tags": ["连接管理"],
        "summary": "断开IBKR连接",
        "description": "断开与Interactive Brokers的连接",
        "responses": {
          "200": {
            "description": "断开成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string", "example": "断开连接成功"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/connection_status": {
      "get": {
        "tags": ["连接管理"],
        "summary": "获取连接状态",
        "description": "查询当前与IBKR的连接状态",
        "responses": {
          "200": {
            "description": "连接状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/historical_data": {
      "post": {
        "tags": ["市场数据"],
        "summary": "获取历史数据",
        "description": "获取指定股票的历史K线数据",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HistoricalDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "历史数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "date": {"type": "string", "description": "日期时间"},
                      "open": {"type": "number", "description": "开盘价"},
                      "high": {"type": "number", "description": "最高价"},
                      "low": {"type": "number", "description": "最低价"},
                      "close": {"type": "number", "description": "收盘价"},
                      "volume": {"type": "integer", "description": "成交量"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/chart_data": {
      "post": {
        "tags": ["市场数据"],
        "summary": "获取图表数据",
        "description": "获取用于图表显示的历史数据",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HistoricalDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "图表数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {"type": "number"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/realtime_data/{symbol}": {
      "get": {
        "tags": ["市场数据"],
        "summary": "获取实时价格",
        "description": "获取指定股票的实时价格数据",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "股票代码",
            "example": "AAPL"
          }
        ],
        "responses": {
          "200": {
            "description": "实时价格数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "symbol": {"type": "string", "description": "股票代码"},
                    "price": {"type": "number", "description": "当前价格"},
                    "bid": {"type": "number", "description": "买价"},
                    "ask": {"type": "number", "description": "卖价"},
                    "volume": {"type": "integer", "description": "成交量"},
                    "timestamp": {"type": "string", "description": "时间戳"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/place_order": {
      "post": {
        "tags": ["交易操作"],
        "summary": "提交订单",
        "description": "提交买卖订单到IBKR",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "订单提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order_id": {"type": "string", "description": "订单ID"},
                    "message": {"type": "string", "description": "成功消息"}
                  }
                }
              }
            }
          },
          "400": {
            "description": "订单参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cancel_order/{order_id}": {
      "delete": {
        "tags": ["交易操作"],
        "summary": "取消指定订单",
        "description": "根据订单ID取消特定订单",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "订单ID"
          }
        ],
        "responses": {
          "200": {
            "description": "取消成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string", "example": "订单取消成功"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/cancel_order": {
      "post": {
        "tags": ["交易操作"],
        "summary": "取消订单",
        "description": "取消指定的订单",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "order_id": {"type": "string", "description": "订单ID"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "取消成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string", "example": "订单取消成功"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/cancel_all_orders": {
      "post": {
        "tags": ["交易操作"],
        "summary": "取消所有订单",
        "description": "取消所有待执行的订单",
        "responses": {
          "200": {
            "description": "批量取消成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string", "example": "所有订单已取消"},
                    "cancelled_count": {"type": "integer", "description": "取消的订单数量"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": ["交易操作"],
        "summary": "获取订单列表",
        "description": "获取所有订单的列表",
        "responses": {
          "200": {
            "description": "订单列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/account_info": {
      "get": {
        "tags": ["账户管理"],
        "summary": "获取账户信息",
        "description": "获取IBKR账户的基本信息和资金状况",
        "responses": {
          "200": {
            "description": "账户信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/positions": {
      "get": {
        "tags": ["账户管理"],
        "summary": "获取持仓信息",
        "description": "获取当前所有持仓的详细信息",
        "responses": {
          "200": {
            "description": "持仓列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Position"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/risk_rules": {
      "get": {
        "tags": ["风险管理"],
        "summary": "获取风险规则",
        "description": "获取所有配置的风险管理规则",
        "responses": {
          "200": {
            "description": "风险规则列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RiskRule"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["风险管理"],
        "summary": "添加风险规则",
        "description": "添加新的风险管理规则",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "symbol": {"type": "string", "description": "股票代码"},
                  "rule_type": {"type": "string", "enum": ["stop_loss", "take_profit"], "description": "规则类型"},
                  "trigger_price": {"type": "number", "description": "触发价格"},
                  "percentage": {"type": "number", "description": "百分比阈值"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "规则添加成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string", "example": "风险规则添加成功"},
                    "rule_id": {"type": "string", "description": "规则ID"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/risk-config": {
      "get": {
        "tags": ["风险管理"],
        "summary": "获取风险配置",
        "description": "获取当前的风险管理配置",
        "responses": {
          "200": {
            "description": "风险配置",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "max_loss_percentage": {"type": "number", "description": "最大亏损百分比"},
                    "max_position_size": {"type": "number", "description": "最大持仓规模"},
                    "risk_level": {"type": "string", "description": "风险等级"}
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["风险管理"],
        "summary": "更新风险配置",
        "description": "更新风险管理配置参数",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "max_loss_percentage": {"type": "number", "description": "最大亏损百分比"},
                  "max_position_size": {"type": "number", "description": "最大持仓规模"},
                  "risk_level": {"type": "string", "description": "风险等级"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "配置更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string", "example": "风险配置更新成功"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auto_orders": {
      "get": {
        "tags": ["风险管理"],
        "summary": "获取自动订单",
        "description": "获取由风险管理系统生成的自动订单",
        "responses": {
          "200": {
            "description": "自动订单列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/strategy/settings": {
      "get": {
        "tags": ["策略管理"],
        "summary": "获取策略设置",
        "description": "获取当前的策略配置设置",
        "responses": {
          "200": {
            "description": "策略设置",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webhook_url": {"type": "string", "description": "Webhook URL"},
                    "auth_token": {"type": "string", "description": "认证令牌"},
                    "is_enabled": {"type": "boolean", "description": "是否启用"}
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["策略管理"],
        "summary": "更新策略设置",
        "description": "更新策略配置设置",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "webhook_url": {"type": "string", "description": "Webhook URL"},
                  "auth_token": {"type": "string", "description": "认证令牌"},
                  "is_enabled": {"type": "boolean", "description": "是否启用"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "设置更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string", "example": "策略设置更新成功"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/strategy/settings/generate-token": {
      "post": {
        "tags": ["策略管理"],
        "summary": "生成策略令牌",
        "description": "为策略认证生成新的令牌",
        "responses": {
          "200": {
            "description": "令牌生成成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {"type": "string", "description": "新生成的令牌"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/strategies": {
      "get": {
        "tags": ["策略管理"],
        "summary": "获取策略列表",
        "description": "获取所有配置的交易策略",
        "responses": {
          "200": {
            "description": "策略列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Strategy"
                  }
                }
              }
            }
          }
