# 本地开发环境配置
# 用于连接VPS上的IB Gateway（通过SSH隧道）

# IBKR Configuration - 通过SSH隧道连接VPS
IBKR_HOST=127.0.0.1
IBKR_PORT=4002  # 通过SSH隧道转发到VPS的IB Gateway
IBKR_CLIENT_ID=1
IBKR_PAPER_TRADING=True
IBKR_MARKET_DATA_TYPE=1
IBKR_TRY_REALTIME_FALLBACK=False

# Web UI - 本地运行
WEB_HOST=127.0.0.1
WEB_PORT=8001  # 使用不同端口避免与VPS转发冲突

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Risk Management
LOSS_THRESHOLD_1=0.05
LOSS_THRESHOLD_2=0.10
CHECK_INTERVAL=5

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password
JWT_SECRET=your_jwt_secret_here

# Database
DATABASE_URL=sqlite:///./data/ibbot.db